# ──────────────────────────────────────
# CRM Einsur Global – Configuración
# ──────────────────────────────────────

APP_NAME="CRM Einsur Global"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/crm_einsurglobal
APP_KEY=base64:GENERA_UNA_CLAVE_SEGURA_DE_32_CHARS

# ── Base de datos ─────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_einsurglobal
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── JWT ───────────────────────────────
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_PRODUCCION
JWT_TTL=3600
JWT_REFRESH_TTL=604800

# ── Mail (SMTP) ──────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@einsurglobal.com
MAIL_FROM_NAME="CRM Einsur Global"
